-------------------------------------------------
-- HELPERS
-------------------------------------------------
local function HRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHitPart(m)
    return m:FindFirstChild("LeftLowerArm")
        or m:FindFirstChild("LeftUpperArm")
        or m:FindFirstChild("UpperTorso")
        or m:FindFirstChild("HumanoidRootPart")
end

local function IsAlive(m)
    local h = m and m:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function GetTargets()
    local h = HRP()
    if not h then return {} end
    local pos = h.Position
    local list = {}

    local folder = workspace:FindFirstChild("Enemies")
    if folder then
        for _, mob in ipairs(folder:GetChildren()) do
            if IsAlive(mob) then
                local root = mob:FindFirstChild("HumanoidRootPart")
                local part = GetHitPart(mob)
                if root and part and (root.Position - pos).Magnitude <= RANGE then
                    table.insert(list, part)
                end
            end
        end
    end

    if Settings.AttackPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr \~= LP and plr.Character and IsAlive(plr.Character) then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                local part = GetHitPart(plr.Character)
                if root and part and (root.Position - pos).Magnitude <= RANGE then
                    table.insert(list, part)
                end
            end
        end
    end
    return list
end

local function DoAttack(targets)
    if not remoteOk or #targets == 0 then return end
    pcall(function()
        RegisterAttack:FireServer(0.4, 1)
    end)
    for _, part in ipairs(targets) do
        pcall(function()
            local args = {
                [1] = part,
                [2] = {},
                [4] = HIT_ID
            }
            RegisterHit:FireServer(unpack(args))
        end)
    end
end

local function GatherMobs()
    local h = HRP()
    if not h then return end
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return end
    local i = 0
    for _, mob in ipairs(folder:GetChildren()) do
        if IsAlive(mob) then
            local root = mob:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - h.Position).Magnitude <= 400 then
                i = i + 1
                local a = (i / 12) * math.pi * 2
                pcall(function()
                    root.CFrame = CFrame.new(h.Position + Vector3.new(math.cos(a) * 10, 0, math.sin(a) * 10))
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end
end

